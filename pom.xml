<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. PARENT: Mengambil template resmi Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/> 
    </parent>

    <!-- 2. IDENTITAS PROYEK KITA -->
    <groupId>com.belajar</groupId>
    <artifactId>my-api</artifactId>
    <version>1.0.0</version>
    <name>my-api</name>
    <description>Enterprise Marketplace Backend - Practice v2</description>

    <!-- 3. VERSI JAVA -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- 4. DEPENDENSI DASAR (Tahap Awal: REST API Web) -->
    <dependencies>
        <!-- Web MVC & Embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <!-- 5. BUILD PLUGIN -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
