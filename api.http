### ========================================================
### 1. PERSIAPAN DATA: USER & PRODUK
### ========================================================

### 1.1 Buka Toko 1: Toko Kopi Nusantara (SELLER)
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Toko Kopi Nusantara",
  "email": "kopinusantara@mail.com",
  "role": "SELLER"
}

### 1.2 Buka Toko 2: Toko Sepatu Original (SELLER)
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Toko Sepatu Original",
  "email": "sepatuori@mail.com",
  "role": "SELLER"
}

### 1.3 Daftar Akun Pembeli: Budi Santoso (BUYER)
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Budi Santoso",
  "email": "budi@mail.com",
  "role": "BUYER"
}

### 1.4 Toko 1 Upload Produk: Kopi Gayo (Stok: 50, Harga: 85.000)
POST http://localhost:8080/api/products
Content-Type: application/json

{
  "name": "Kopi Gayo Arabika",
  "description": "Biji kopi premium 250g",
  "price": 85000.0,
  "stock": 50,
  "category": "Minuman",
  "sellerId": 1
}

### 1.5 Toko 2 Upload Produk: Sepatu Nike (Stok: 15, Harga: 850.000)
POST http://localhost:8080/api/products
Content-Type: application/json

{
  "name": "Sepatu Lari Nike Pegasus",
  "description": "Ukuran 42 warna hitam",
  "price": 850000.0,
  "stock": 15,
  "category": "Sepatu",
  "sellerId": 2
}


### ========================================================
### 2. SIMULASI CHECKOUT MULTI-ITEM (KERANJANG BELANJA)
### ========================================================

### 2.1 Budi (Buyer ID: 3) Beli 2 Kopi dan 1 Sepatu Sekaligus!
# Ekspektasi: 
# - Subtotal Kopi: 2 x 85.000 = 170.000 (Sisa Stok Kopi: 50 -> 48)
# - Subtotal Sepatu: 1 x 850.000 = 850.000 (Sisa Stok Sepatu: 15 -> 14)
# - Total Transaksi: Rp 1.020.000
POST http://localhost:8080/api/orders
Content-Type: application/json

{
  "buyerId": 3,
  "items": [
    {
      "productId": 1,
      "quantity": 2
    },
    {
      "productId": 2,
      "quantity": 1
    }
  ]
}

### 2.2 Cek Sisa Stok Kopi (Harusnya tinggal 48)
GET http://localhost:8080/api/products/1

### 2.3 Cek Sisa Stok Sepatu (Harusnya tinggal 14)
GET http://localhost:8080/api/products/2

### 2.4 Cek Seluruh Riwayat Orders (Lengkap dengan data Pembeli & Daftar Items)
GET http://localhost:8080/api/orders


### ========================================================
### 3. SIKLUS STATUS & RESTOCK MULTI-ITEM
### ========================================================

### 3.1 Budi Membatalkan Pesanan (CANCELLED)
# Ekspektasi: Order dibatalkan, KEDUA BARANG otomatis di-restock!
# - Kopi kembali pulih: 48 -> 50
# - Sepatu kembali pulih: 14 -> 15
PUT http://localhost:8080/api/orders/1/status
Content-Type: application/json

{
  "status": "CANCELLED"
}

### 3.2 Cek Stok Kopi Kembali Pulih Menjadi 50!
GET http://localhost:8080/api/products/1

### 3.3 Cek Stok Sepatu Kembali Pulih Menjadi 15!
GET http://localhost:8080/api/products/2
